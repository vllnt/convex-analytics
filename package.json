{
  "name": "convex-analytics-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build --concurrency=2",
    "test": "turbo run test --concurrency=2",
    "lint": "pnpm check:agents && turbo run lint --concurrency=2",
    "typecheck": "turbo run typecheck --concurrency=2",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\"",
    "codegen": "pnpm --filter @vllnt/convex-analytics codegen",
    "typecheck:ci": "turbo run typecheck:ci --concurrency=2",
    "test:coverage": "turbo run test:coverage --concurrency=2"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=10.0.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@vllnt/eslint-config": "2.0.0",
    "eslint": "^9.39.5",
    "turbo": "^2.11.10",
    "typescript-eslint": "^8.72.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "minimumReleaseAge": 10080,
    "minimumReleaseAgeExclude": [
      "@vllnt/*"
    ],
    "ignoredBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "convex-helpers": "0.1.129",
      "deepmerge-ts@<8.0.0": "8.0.2",
      "handlebars@<4.7.10": "4.7.10"
    }
  }
}
