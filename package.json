{
  "name": "convex-analytics-monorepo",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "build": "turbo run build",
    "test": "turbo run test",
    "lint": "pnpm check:agents && turbo run lint",
    "typecheck": "turbo run typecheck",
    "check:agents": "node -e \"const f=require('node:fs');if(!f.existsSync('AGENTS.md')||f.existsSync('CLAUDE.md')||f.existsSync('.claude'))process.exit(1)\"",
    "codegen": "pnpm --filter @vllnt/convex-analytics codegen"
  },
  "engines": {
    "npm": "please-use-pnpm",
    "yarn": "please-use-pnpm",
    "pnpm": ">=9.0.0"
  },
  "devDependencies": {
    "@typescript/native": "npm:typescript@7.0.2",
    "@vllnt/eslint-config": "2.0.0",
    "convex": "^1.48.0",
    "eslint": "^9.39.5",
    "turbo": "^2.11.10",
    "typescript": "npm:@typescript/typescript6@^6.0.2"
  },
  "pnpm": {
    "overrides": {
      "@asamuzakjp/css-color": "7.1.7",
      "@convex-dev/rate-limiter": "0.4.2",
      "@csstools/css-color-parser": "4.2.6",
      "@csstools/css-syntax-patches-for-csstree": "1.1.15",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "convex": "1.48.0",
      "convex-helpers": "0.1.129",
      "deepmerge-ts@<8.0.0": "8.0.0",
      "handlebars": "4.7.10",
      "magic-string": "1.4.3",
      "postcss": "8.5.31",
      "rolldown": "1.2.15",
      "zod@<4.6.6": "4.6.6"
    }
  }
}
