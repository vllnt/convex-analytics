{
  "name": "@vllnt/convex-analytics",
  "version": "0.1.1",
  "description": "Generic, configurable analytics component for Convex \u2014 any event, any dimension, any domain; rollup-on-write with funnels, retention, uniques",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "main": "./dist/client/index.js",
  "module": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && cp ../../README.md ../../LICENSE ./",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo",
    "lint": "pnpm --dir ../.. check:agents && eslint --cache --cache-location node_modules/.cache/eslint/ src/",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test:coverage && pnpm typecheck",
    "codegen": "node scripts/codegen.mjs",
    "build:codegen": "pnpm codegen && pnpm build"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/rate-limiter": "^0.4.2",
    "@convex-dev/sharded-counter": "^0.2.3",
    "convex": "^1.48.0"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.0.5",
    "@vllnt/typescript": "2.0.0",
    "convex-test": "^0.0.65",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "convex": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "homepage": "https://github.com/vllnt/convex-analytics#readme",
  "bugs": {
    "url": "https://github.com/vllnt/convex-analytics/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-analytics.git"
  },
  "keywords": [
    "convex",
    "convex-component",
    "analytics",
    "events",
    "metrics",
    "funnels",
    "retention",
    "rollup",
    "vllnt"
  ]
}
