{
  "name": "@vllnt/convex-analytics",
  "version": "0.2.0",
  "description": "TypeScript Convex component for event analytics: track events, roll up counts on write, and query metrics, breakdowns, time series, funnels and retention.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.34.8",
  "main": "./dist/client/index.js",
  "module": "./dist/client/index.js",
  "types": "./dist/client/index.d.ts",
  "sideEffects": false,
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "types": "./dist/client/index.d.ts",
      "default": "./dist/client/index.js"
    },
    "./test": "./src/test.ts",
    "./web": {
      "types": "./dist/web/index.d.ts",
      "default": "./dist/web/index.js"
    },
    "./react": {
      "types": "./dist/react/index.d.ts",
      "default": "./dist/react/index.js"
    },
    "./convex.config": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./convex.config.js": {
      "types": "./dist/component/convex.config.d.ts",
      "default": "./dist/component/convex.config.js"
    },
    "./_generated/component.js": {
      "types": "./dist/component/_generated/component.d.ts"
    }
  },
  "files": [
    "dist",
    "src",
    "docs/quick-start.md",
    "docs/client-sdk.md",
    "docs/schema.md",
    "docs/api-reference.md",
    "docs/web-preset.md",
    "docs/react.md",
    "docs/multi-product.md",
    "docs/architecture.md",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "llms.txt",
    "!src/**/*.test.*",
    "!src/**/*.spec.*"
  ],
  "scripts": {
    "build": "rm -rf dist docs && tsc && cp ../../README.md ../../LICENSE ../../llms.txt ./ && cp -R ../../docs ./docs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck.tsbuildinfo",
    "typecheck:ci": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/typecheck-ci.tsbuildinfo",
    "lint": "pnpm --dir ../.. check:agents && eslint --cache --cache-location node_modules/.cache/eslint/ src/",
    "preversion": "pnpm install --frozen-lockfile && pnpm build && pnpm test:coverage && pnpm typecheck",
    "codegen": "node scripts/codegen.mjs",
    "test:package": "node scripts/test-package.mjs",
    "build:codegen": "pnpm codegen && pnpm build"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.3.4",
    "@convex-dev/rate-limiter": "^0.4.3",
    "@convex-dev/sharded-counter": "^0.2.4"
  },
  "devDependencies": {
    "@edge-runtime/vm": "^5.0.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitest/coverage-v8": "^5.1.1",
    "@vllnt/typescript": "3.0.0",
    "convex": "^1.51.0",
    "convex-test": "^0.0.73",
    "eslint": "^10.15.0",
    "jsdom": "^31.0.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "peerDependencies": {
    "convex": "^1.45.0",
    "react": ">=18.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "publishConfig": {
    "access": "public"
  },
  "author": {
    "name": "bntvllnt",
    "url": "https://bntvllnt.com"
  },
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/bntvllnt"
  },
  "homepage": "https://oss.vllnt.com/packages/convex-analytics",
  "bugs": {
    "url": "https://github.com/vllnt/convex-analytics/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/vllnt/convex-analytics"
  },
  "keywords": [
    "convex",
    "convex-component",
    "typescript",
    "analytics",
    "event-tracking",
    "metrics",
    "time-series",
    "funnel",
    "retention",
    "rollups",
    "web-analytics",
    "react"
  ]
}
